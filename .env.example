# Google Calendar (see README/Google Cloud setup)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Vercel
VERCEL_TOKEN=your_new_vercel_token_here
VERCEL_PROJECT_ID=prj_GnrK29nhDvevHYXpHXPDNmduv4Q8
VERCEL_TEAM_ID=

# Supabase
SUPABASE_URL=https://dgyosqcjyaiqaaitjlir.supabase.co
SUPABASE_SERVICE_KEY=your_new_supabase_key_here

# Optional: Google Analytics 4 Data API (alternative to Vercel Analytics)
# Create a Service Account in Google Cloud, download JSON key, place on server
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_PATH=./ga4-key.json

# Optional: Cloudflare Analytics (if domain is proxied through Cloudflare)
CF_API_TOKEN=your_cf_token_here
CF_ZONE_ID=your_cf_zone_id_here

# Cron schedule (Europe/Moscow 08:00)
TZ=Europe/Moscow
DIGEST_HOUR=08
DIGEST_MINUTE=00

# Deployment mode
# standalone = обычный Telegram-бот с polling
# backend = только API + cron (для совместной работы с OpenClaw)
MODE=standalone
PORT=3000
