[Unit]
Description=Athena Telegram Bot
After=network.target

[Service]
Type=simple
User=athena
WorkingDirectory=/opt/athena-bot
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
Environment="NODE_ENV=production"
Environment="TZ=Europe/Moscow"
EnvironmentFile=/opt/athena-bot/.env

# Логи
StandardOutput=append:/var/log/athena-bot.log
StandardError=append:/var/log/athena-bot.log

[Install]
WantedBy=multi-user.target
